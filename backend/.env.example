# Backend runtime settings for production or local development
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# Optional settings
# SESSION_TTL_MS=21600000
# UPLOAD_FILE_SIZE_LIMIT=20971520
# Set the Python interpreter used by backend guide generation.
# PYTHON=.venv/bin/python
# Optional model overrides. The segmentation default is yolo11s-seg.pt.
# YOLO_DETECT_WEIGHTS=yolov8n.pt
# YOLO_SEG_WEIGHTS=yolo11s-seg.pt
# YOLO_POSE_WEIGHTS=yolov8n-pose.pt

# Progressive guidance weights/thresholds. New trials snapshot this file.
# GUIDANCE_CONFIG=/absolute/path/to/guidance_config.json

# Participant flow plans and questionnaire / capture-limit configuration
# EXPERIMENT_PLAN_DIR=/absolute/path/to/experiment_plans
# EXPERIMENT_FLOW_CONFIG=/absolute/path/to/experiment_flow_config.json

# Researcher APIs are disabled unless this secret is set; send X-Research-Token.
# RESEARCH_ADMIN_TOKEN=use-a-long-random-secret
# Optional local export and backup destinations (outside backend/uploads).
# RESEARCH_EXPORT_DIR=/absolute/path/to/exports
# RESEARCH_BACKUP_DIR=/absolute/path/to/backups
# Participant experiments are exempt from SESSION_TTL_MS; ordinary sessions are not.
