# Backend runtime settings for production or local development
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# Optional settings
# SESSION_TTL_MS=21600000
# UPLOAD_FILE_SIZE_LIMIT=20971520
# Set the Python interpreter used by backend guide generation.
# PYTHON=.venv/bin/python
# Optional model overrides. The segmentation default is yolo11s-seg.pt.
# YOLO_DETECT_WEIGHTS=yolov8n.pt
# YOLO_SEG_WEIGHTS=yolo11s-seg.pt
# YOLO_POSE_WEIGHTS=yolov8n-pose.pt
